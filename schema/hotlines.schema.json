{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teduh.example/schema/hotlines.schema.json",
  "title": "Teduh hotlines (no-location services, data/hotlines.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "contacts",
      "sources"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2
      },
      "lat": {
        "type": "null"
      },
      "lng": {
        "type": "null"
      },
      "contacts": {
        "type": "object"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "url"
          ]
        }
      },
      "contact_sources": {
        "description": "Where each phone/WhatsApp number in this record is published by the institution or owner itself (consent policy, CONTRIBUTING.md). Every number found in the record must be listed here.",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "number",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "number": {
              "type": "string",
              "minLength": 5
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "note": {
              "type": "string"
            },
            "checked": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    }
  }
}
