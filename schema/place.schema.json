{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teduh.example/schema/place.schema.json",
  "title": "Teduh place record (SCHEMA.md v3)",
  "description": "Derived from data/SCHEMA.md v3 (2026-10-31). One file per place: data/places/<id>.json. Free-text evidence fields stay loosely typed on purpose (they are stored as found). Extra rules that JSON Schema cannot express (id == filename, approx_coords never a pin, no contributor flip to 'active') live in scripts/validate.py and scripts/guard_pr.py.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "status",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "short": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "pattern": "^(kesehatan-mental|tumbuh-kembang-anak|layanan-pendampingan|psikologi)(/[A-Za-z0-9-]+)+$"
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "also_in_categories": {
      "type": "array",
      "items": {
        "enum": [
          "kesehatan-mental",
          "tumbuh-kembang-anak",
          "layanan-pendampingan",
          "psikologi"
        ]
      }
    },
    "address": {
      "type": "string"
    },
    "kelurahan": {
      "type": "string"
    },
    "kecamatan": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "coord_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "latlng_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "approx_coords": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      ],
      "description": "OSM street midpoint or map viewport. NEVER a pin."
    },
    "contacts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "array",
          "object",
          "null"
        ]
      }
    },
    "hours": {
      "type": [
        "string",
        "object"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_range": {
      "type": "string"
    },
    "price_per_session": {
      "type": [
        "string",
        "object"
      ]
    },
    "cost": {
      "type": "string"
    },
    "bpjs": {
      "type": "string"
    },
    "booking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waitlist": {
      "type": "string"
    },
    "eligibility": {
      "type": "string"
    },
    "complaint_method": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "therapists": {
      "type": [
        "string",
        "array"
      ]
    },
    "local_notes": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "needs-check"
      ],
      "description": "active = verified by the team. Contributions are always needs-check."
    },
    "open_issues": {
      "type": [
        "string",
        "null"
      ]
    },
    "field_confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "validation_note": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 4
          },
          "note": {
            "type": "string"
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "what_changed"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "batch": {
            "type": "string"
          },
          "what_changed": {
            "type": "string"
          }
        }
      }
    },
    "what_changed": {
      "type": "string"
    },
    "archived_from": {
      "type": "string"
    },
    "facility_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scope": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "schedule_note": {
      "type": "string"
    },
    "evidence": {
      "type": [
        "array",
        "string"
      ]
    },
    "independence_note": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "searched": {
      "type": [
        "array",
        "string"
      ]
    },
    "activity_evidence": {
      "type": [
        "array",
        "string"
      ]
    },
    "name_display": {
      "type": "string"
    },
    "address_display": {
      "type": [
        "string",
        "null"
      ]
    },
    "kelurahan_display": {
      "type": [
        "string",
        "null"
      ]
    },
    "kecamatan_display": {
      "type": [
        "string",
        "null"
      ]
    },
    "city_display": {
      "enum": [
        "Banjarbaru",
        "Kabupaten Banjar"
      ]
    },
    "address_note_id": {
      "type": "string"
    },
    "note_id": {
      "type": "string"
    },
    "hours_normalized": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "open",
          "close"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "enum": [
              "senin",
              "selasa",
              "rabu",
              "kamis",
              "jumat",
              "sabtu",
              "minggu"
            ]
          },
          "open": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01]\\d|2[0-4])\\.[0-5]\\d$"
          },
          "close": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01]\\d|2[0-4])\\.[0-5]\\d$"
          },
          "closed": {
            "type": "boolean"
          }
        }
      }
    },
    "hours_note_id": {
      "type": "string"
    },
    "services_display": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "booking_display": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_sources": {
      "description": "Where each phone/WhatsApp number in this record is published by the institution or owner itself (consent policy, CONTRIBUTING.md). Every number found in the record must be listed here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "minLength": 5
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string"
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lat": {
            "type": "number"
          }
        },
        "required": [
          "lat"
        ]
      },
      "then": {
        "properties": {
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lng"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs-check"
          }
        }
      },
      "then": {
        "required": [
          "open_issues"
        ],
        "properties": {
          "open_issues": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  ]
}
